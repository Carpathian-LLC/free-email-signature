# ------------------------------------------------------------------------------------
# Free Email Signature Generator - Environment Configuration
# ------------------------------------------------------------------------------------
# Copy this file to keys.env and fill in your values.
# keys.env is git-ignored and will never be committed.
# ------------------------------------------------------------------------------------

# ── Frontend ─────────────────────────────────────────────────────────
VITE_SITE_URL=https://url.com
VITE_API_URL=http://localhost:8001

# ── Analytics (optional) ─────────────────────────────────────────────
# Only loaded after the user accepts analytics in the consent banner.
VITE_GTAG_ID=
VITE_CLARITY_ID=

# ── Ads (optional) ───────────────────────────────────────────────────
# Google AdSense publisher ID, format ca-pub-XXXXXXXXXXXXXXXX. Loads for
# every visitor, not gated by the consent banner.
VITE_ADSENSE_CLIENT=
# AdSense display unit slot ID (numeric data-ad-slot from the unit you create
# in the AdSense console). The site-wide AdSense banner renders only when set.
VITE_ADSENSE_BANNER_SLOT=
# Legacy Adsterra ad units. Leave blank to disable. Banner/sidebar keys are
# hex; network is a domain (e.g. *.highperformanceformat.com).
VITE_AD_BANNER_NETWORK=
VITE_AD_BANNER_KEY=
VITE_AD_SIDEBAR_KEY=
VITE_AD_NATIVE_SCRIPT=
VITE_AD_NATIVE_CONTAINER=

# ── Backend ──────────────────────────────────────────────────────────
FRONTEND_HOST=0.0.0.0
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=5173
BACKEND_PORT=8001
ALLOWED_ORIGINS=http://localhost:5173
COS_SALT=generate-a-random-string-here
MAX_UPLOAD_BYTES=2097152
MAX_IMAGE_DIMENSION=2000
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=5
TRUST_PROXY=false

# ── Database ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_emailgen
DB_POOL_SIZE=5
DB_SSL=true
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
